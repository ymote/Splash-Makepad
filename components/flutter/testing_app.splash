// testing_app — flutter/samples/testing_app
//
// A deliberately tiny favourites app (a 20-row list, a favourites screen, a
// snackbar on toggle) that exists as a fixture for the sample's unit, widget
// and integration tests.
//
// The UI ports in full, and it now works: tapping a heart favourites the item,
// the favourites screen lists what is actually favourited, and the count and
// the snackbar follow. That used to be three hardcoded rows and a heart that
// was a picture of a heart.
//
// The reason the sample exists still does not port: its value is the `test/`
// and `integration_test/` directories — testWidgets, WidgetTester,
// pumpAndSettle, Key-based finders. There is no widget-test harness for the
// Splash pipeline, and the translated output is a makepad dialect string, so
// the closest analogue is asserting on that string — which is what
// `tests/flutter_samples.rs` in this repo does for every screen.

fn ta_key(i) { return "testing_fav_" + i }

// The three the sample starts favourited. Written as separate `if`s because
// `a or b` is not an operator in this VM — it parsed, evaluated to something
// unhelpful, and the count came out as 1 instead of 3 with nothing to say so.
fn ta_start(i) {
    if i == 2 { return 1 }
    if i == 5 { return 1 }
    if i == 9 { return 1 }
    return 0
}

fn ta_fav(i) { return son_d(ta_key(i), ta_start(i)) }

fn ta_row(i, name) {
    let fav = ta_fav(i)
    return {t: "column", fillw: 1, c: [
        {t: "row", fillw: 1, h: 56, padx: 16, spacing: 12, aligny: 0.5,
         tapto: act_toggle(ta_key(i)), c: [
            txt(name, 16, 400, m_on_surface),
            spacer(),
            icon(ic_heart, 15, pick_if(fav, m_error, m_on_surf_var)),
        ]},
        rule(m_outline_var),
    ]}
}

fn screen_testing_app() {
    let rows = []
    let n = 0
    let i = 1
    while i <= 12 {
        rows.push(ta_row(i, "Item " + i))
        if ta_fav(i) { n = n + 1 }
        i = i + 1
    }
    return page(m_surface, [
        m_appbar("Testing Sample", "index"),
        {t: "row", fillw: 1, padx: 16, pady: 8, spacing: 8, aligny: 0.5, c: [
            txt("Tap a row to favourite it", 13, 400, m_on_surf_var),
            spacer(),
            {t: "row", h: 40, radius: 20, bg: m_pri_cont, padx: 16, fitw: 1,
             spacing: 8, aligny: 0.5, tapto: "testing_app/favorites", c: [
                icon(ic_heart, 13, m_on_pri_cont),
                txt("Favorites " + n, 14, 500, m_on_pri_cont),
            ]},
        ]},
        {t: "scroll", fillw: 1, fillh: restfill(), c: rows},
        // The SnackBar the sample shows on each toggle. It says the count now,
        // because a message that never changes is not feedback.
        {t: "row", bg: m_inv_surf, radius: 4, fillw: 1, h: 48, padx: 16,
         aligny: 0.5, c: [
            txt(n + " in favorites.", 14, 400, m_inv_on),
        ]},
    ])
}

fn screen_testing_app_favorites() {
    let rows = []
    let i = 1
    while i <= 12 {
        if ta_fav(i) { rows.push(ta_row(i, "Item " + i)) }
        i = i + 1
    }
    if rows.len() == 0 {
        rows.push({t: "column", fillw: 1, pad: 32, alignx: 0.5, c: [
            para("Nothing favourited yet.", 14, 400, m_on_surf_var),
        ]})
    }
    return page(m_surface, [
        m_appbar("Favorites", "testing_app"),
        {t: "scroll", fillw: 1, c: rows},
    ])
}
