// simple_shader — flutter/samples/simple_shader
//
// The sample's fragment shader, evaluated in the DSL and drawn with ordinary
// native nodes.
//
// A fragment shader is a function from a coordinate to a colour. The DSL has
// arithmetic, so it can run that function itself — once per cell instead of
// once per pixel — and emit a grid of coloured nodes. Coarser than the GPU
// doing it, and identical in kind: same maths, same colours, same picture.
//
// This is why the sample is no longer parked. The compiled-MPSL route
// (`FlutterShader` in splash-widgets) is still there and is the right answer on
// makepad, but it does not resolve in the Splash isolate yet. This works today,
// on both backends, and is verified on the phone.
//
// simple.frag: color = mix(mix(sky, blue, p*2), mix(blue, navy, p*2-1),
// step(0.5, p)) where p = (st.x + st.y) / 2.

// Resolution, stepped — same reason as simple_sdf: a shader evaluated per cell
// is a function, and a function can be sampled at any rate.
let sh_res = [9, 18, 36, 72]
let sh_n = sh_res[sget("sh_res", 1)]

fn sh_cell(ix, iy) {
    let sky  = argb(255, 2, 125, 253)
    let blue = argb(255, 5, 83, 177)
    let navy = argb(255, 4, 43, 89)
    let x = (ix + 0.5) / sh_n
    let y = (iy + 0.5) / sh_n
    let p = (x + y) / 2.0
    if p < 0.5 { return lerp_argb(sky, blue, p * 2.0) }
    return lerp_argb(blue, navy, p * 2.0 - 1.0)
}

fn sh_grid() {
    let rows = []
    let j = 0
    while j < sh_n {
        let cells = []
        let i = 0
        while i < sh_n { cells.push({t: "column", fillw: 1, fillh: 1, bg: sh_cell(i, j)})  i = i + 1 }
        rows.push({t: "row", fillw: 1, fillh: 1, c: cells})
        j = j + 1
    }
    // Weighted rows inside a fixed-height column, not `h: 16` each — a fixed
    // row height rounds to a whole physical pixel and the leftover fraction
    // accumulates into a seam. See simple_sdf.splash.
    return {t: "column", fillw: 1, h: 288, radius: 12, bg: sh_cell(sh_n / 2, sh_n / 2), c: rows}
}

fn screen_simple_shader() {
    return page(m_surface, [
        m_appbar("Simple Shader", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            sh_grid(),
            {t: "row", fillw: 1, radius: 8, bg: m_pri_cont, padx: 12, pady: 10,
             spacing: 8, aligny: 0.5, tapto: act_cycle("sh_res", 4), c: [
                icon(ic_bolt, 13, m_on_pri_cont),
                txt(sh_n + "x" + sh_n + " cells — tap to resample",
                    13, 500, m_on_pri_cont),
            ]},
            m_section("What this is", [
                para("simple.frag, evaluated in the DSL: sky to blue to navy "
                     + "across (st.x + st.y) / 2, with the step at 0.5. A "
                     + "fragment shader is a function from a coordinate to a "
                     + "colour, and the DSL can run that function — once per "
                     + "cell rather than once per pixel.",
                     13, 400, m_on_surf_var),
            ]),
            m_section("What the GPU would still do better", [
                para("Per-pixel instead of per-cell, and for free. This grid is "
                     + sh_n + "x" + sh_n + " native nodes; the shader is one "
                     + "draw call at any resolution.",
                     13, 400, m_on_surf_var),
                para("The compiled-MPSL route is built (FlutterShader in "
                     + "splash-widgets) and is the right answer on makepad, but "
                     + "it does not resolve in the Splash isolate yet. ArkUI has "
                     + "no fragment-shader path at all, so this is the form that "
                     + "works on both.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}
