// docs — flutter/samples/docs
//
// Not a UI port: this sample is configuration, tooling or prose. It states
// what the counterpart on this stack is rather than dismissing it.

fn screen_docs() {
    return counterpart_screen("docs",
        "The repository's own documentation — contribution notes and the architecture write-ups that accompany compass_app.",
        "This project documents itself in the same places: the repo READMEs, FLUTTER-SAMPLES.md on the ArkUI side, and a header comment at the top of every file in components/flutter explaining what that sample is and what it is not. The write-ups that matter here are the ones recording what was tried and failed — the shader that compiles and does not draw, the isolate seam — because those are the things a reader would otherwise have to rediscover.",
        ["Nothing renders. Prose is prose in both repos."])
}
