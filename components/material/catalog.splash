// ---- interactive overlays + new components (st.open = the one open overlay) --
// Real behaviour, not static mocks: a trigger Button sets st.open; the DSL renders
// the overlay and a Button inside clears it. The host Splash is height:Fit, so a
// Fill scrim would collapse — use a fixed tall scrim to cover the viewport.

fn modal_over(content, ay) {
    return {t: "stack", fillw: 1, c: [
        {t: "column", bg: argb(150, 0, 0, 0), fillw: 1, h: 820},
        {t: "column", fillw: 1, h: 820, alignx: 0.5, aligny: ay, pad: 16, c: [ content ]},
    ]}
}
fn modal_edge(content, ax) {
    return {t: "stack", fillw: 1, c: [
        {t: "column", bg: argb(150, 0, 0, 0), fillw: 1, h: 820},
        {t: "row", fillw: 1, h: 820, alignx: ax, aligny: 0.0, c: [ content ]},
    ]}
}
// The root overlay layer — a real modal when st.open names one, else nothing.
fn overlay() {
    if st.open == "dialog" { return modal_over(dialog(), 0.5) }
    if st.open == "sheet"  { return modal_over(bottom_sheet(), 1.0) }
    if st.open == "drawer" { return modal_edge(nav_drawer(), 0.0) }
    if st.open == "side"   { return modal_edge(side_sheet(), 1.0) }
    return {t: "column", c: []}
}

// Dropdown menus that actually open/close; each item taps to dismiss.
fn menu_btn(txt) { return {t: "button", label: txt, tapto: "open:", fillw: 1, h: 44} }
fn imenu() {
    if st.open != "menu" { return {t: "column", h: 0} }
    return {t: "column", bg: surf_cont, border: 1, bordercolor: outline_var, radius: 4, pad: 8, w: 220, spacing: 2, c: [
        menu_btn("Edit"), menu_btn("Duplicate"), menu_btn("Share"), menu_btn("Delete"),
    ]}
}
fn ioverflow() {
    if st.open != "overflow" { return {t: "column", h: 0} }
    return {t: "column", alignx: 1.0, c: [
        {t: "column", bg: surf_cont, border: 1, bordercolor: outline_var, radius: 4, pad: 8, w: 210, spacing: 2, c: [
            menu_btn("Settings"), menu_btn("Help & feedback"), menu_btn("Sign out"),
        ]},
    ]}
}
fn itooltip() {
    if st.open != "tooltip" { return {t: "column", h: 0} }
    return {t: "row", c: [ tooltip() ]}
}

// A real (tappable, rippling) icon button — the Button label renders in the icon
// font via icon:1, and each tap bumps the live counter so the ripple fires.
fn tool_btn(icon) { return {t: "button", label: icon, icon: 1, size: 20, tapto: "act:count", fitw: 1, h: 48} }
fn docked_toolbar() {
    return {t: "row", bg: surf_cont, radius: 16, pad: 8, h: 64, spacing: 4, aligny: 0.5, c: [
        tool_btn("\u{f0c9}"), tool_btn("\u{f005}"), tool_btn("\u{f0e0}"), tool_btn("\u{f044}"),
        {t: "column", c: []},
        tool_btn("\u{f067}"),
    ]}
}
fn floating_toolbar() {
    return {t: "row", bg: pri_container, radius: 28, pad: 8, fitw: 1, spacing: 4, aligny: 0.5, c: [
        tool_btn("\u{f068}"), tool_btn("\u{f067}"), tool_btn("\u{f0c1}"),
    ]}
}

// Motion — a real container-transform-style expand/collapse (state-driven, so the
// swap is instant; the re-mount pipeline can't tween).
fn imotion() {
    if st.open == "motion" {
        return {t: "column", bg: pri_container, radius: 16, pad: 16, spacing: 8, c: [
            {t: "text", text: "Expanded surface", size: 16, weight: 500, color: on_pri_cont, h: 24},
            {t: "text", text: "The tapped card transformed into this larger surface. Tap collapse to return.", size: 14, color: on_pri_cont, w: 300, h: 44},
            {t: "button", label: "Collapse", tapto: "open:", fitw: 1, h: 40},
        ]}
    }
    return {t: "row", c: [ {t: "button", label: "Expand card", tapto: "open:motion", fitw: 1, h: 40} ]}
}

fn demo_more() {
    return demo("Toolbars & motion", [
        section("Docked toolbar", [ docked_toolbar() ]),
        section("Floating toolbar", [ {t: "row", c: [ floating_toolbar() ]} ]),
        section("Overflow menu (tap)", [
            {t: "row", spacing: 8, aligny: 0.5, c: [
                {t: "text", text: "Actions", size: 14, color: on_surface, fitw: 1},
                {t: "column", c: []},
                {t: "button", label: "\u{f142}", icon: 1, size: 20, tapto: "open:overflow", fitw: 1, h: 44},
            ]},
            ioverflow(),
        ]),
        section("Motion \u{00b7} container transform (tap)", [ imotion() ]),
    ])
}

// Route the injected `screen` to the matching demo, defaulting to home.
fn body(s) {
    if s == "buttons" { return demo_buttons() }
    if s == "selection" { return demo_selection() }
    if s == "text" { return demo_text() }
    if s == "chips" { return demo_chips() }
    if s == "cards" { return demo_cards() }
    if s == "nav" { return demo_nav() }
    if s == "comms" { return demo_comms() }
    if s == "pickers" { return demo_pickers() }
    if s == "progress" { return demo_progress() }
    if s == "type" { return demo_type() }
    if s == "more" { return demo_more() }
    return home_screen()
}

// ---- root ------------------------------------------------------------------
// The screen, with a real modal overlay stacked on top when st.open is set.
{t: "stack", fillw: 1, c: [
    {t: "column", bg: page, pad: 16, spacing: 16, c: [ body(st.route) ]},
    overlay(),
]}
