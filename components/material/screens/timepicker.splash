{t:"scroll", c:[ {t:"col", pad: 16, pady: 8, spacing: 16, c: [

  section("Time pickers"),
  caption("MaterialTimePicker in both input modes."),
  {t:"col", spacing: 8, c:[
    {t:"button", variant:"tonal", label:"Clock mode (12h)", key:"tp", action:"clock12", tap: 1},
    {t:"button", variant:"tonal", label:"Clock mode (24h)", key:"tp", action:"clock24", tap: 1},
    {t:"button", variant:"tonal", label:"Text input mode",  key:"tp", action:"input",   tap: 1},
  ]},
  caption("Selected: " + S("tp_result"))
]} ]}
