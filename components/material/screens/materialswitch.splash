{t:"scroll", c:[ {t:"col", pad: 16, pady: 8, spacing: 16, c: [

  section("Switch"),
  caption("M3 switch, with and without icons."),
  {t:"col", spacing: 0, c:[
    {t:"switch", text:"Wi-Fi",        key:"sw1", on: N("sw1", 1)},
    {t:"switch", text:"Bluetooth",    key:"sw2", on: N("sw2", 0)},
